---
/**
 * Icon.astro — 線画アイコン（絵文字のかわり）
 * ・24×24 の1色線画。色は currentColor（置いた場所の文字色）を継ぐ。
 * ・線は 1.8 / 角と端は round ＝ 手描きの世界観に合わせる。
 * 使い方: <Icon name="beer" /> / <Icon name="beer" size={26} sw={2} class="ic" />
 */
const ICONS: Record<string, string> = {
  // 鉛筆（つくる）
  pencil: `<path d="M5.2 18.8l.8-3 8.2-8.2 2.2 2.2-8.2 8.2z"/><path d="M14.2 7.6l1.5-1.5a1.6 1.6 0 0 1 2.2 0l.2.2a1.6 1.6 0 0 1 0 2.2l-1.5 1.5z"/><path d="M6 15.8l2.2 2.2"/>`,
  // ビール（売り子・ドーム）
  beer: `<path d="M6.2 8.4h9.6v8.2a3 3 0 0 1-3 3H9.2a3 3 0 0 1-3-3z"/><path d="M15.8 10.4h2a2.4 2.4 0 0 1 0 4.8h-2"/><path d="M6.2 8.4c-.4-1.8 1.2-2.9 2.4-2.1.3-1.7 2.5-2.2 3.4-.7 1-1.2 3.2-.7 3.2 1.1 1.1.1 1.4 1 .6 1.7"/><path d="M7 11.6h8"/>`,
  // トロフィー（順位）
  trophy: `<path d="M7.6 4.8h8.8v2.6a4.4 4.4 0 0 1-8.8 0z"/><path d="M7.6 6.2H5.4a2.6 2.6 0 0 0 2.8 3"/><path d="M16.4 6.2h2.2a2.6 2.6 0 0 1-2.8 3"/><path d="M12 11.8v3"/><path d="M10.2 14.8h3.6l.7 4.2H9.5z"/><path d="M8.4 19h7.2"/>`,
  // メダル（ランキング）
  medal: `<circle cx="12" cy="9.4" r="4.6"/><path d="M9.6 13.4L7.6 20l4.4-2.3L16.4 20l-2-6.6"/>`,
  // にっこり（愛嬌・自己プロデュース）
  smile: `<circle cx="12" cy="12" r="7.8"/><path d="M9.2 10.4v.9"/><path d="M14.8 10.4v.9"/><path d="M8.6 14.2a4.4 4.4 0 0 0 6.8 0"/>`,
  // 小包（つくって、手渡す）
  parcel: `<path d="M4.8 8.6h14.4v10.4H4.8z"/><path d="M4.8 12h14.4"/><path d="M12 8.6v10.4"/><path d="M9.4 8.6c-1.6 0-2.6-.8-2.6-2 0-1 .8-1.6 1.6-1.6 1.6 0 2.8 1.6 3.6 3.6"/><path d="M14.6 8.6c1.6 0 2.6-.8 2.6-2 0-1-.8-1.6-1.6-1.6-1.6 0-2.8 1.6-3.6 3.6"/>`,
  // ディスプレイ（CG・画像処理）
  monitor: `<path d="M12 3.2 20.4 7.8v8.4L12 20.8 3.6 16.2V7.8z"/><path d="M3.6 7.8 12 12.4l8.4-4.6"/><path d="M12 12.4v8.4"/>`,
  // スマホ（Web・アプリ）
  phone: `<path d="M8.2 3.8h7.6a1.4 1.4 0 0 1 1.4 1.4v13.6a1.4 1.4 0 0 1-1.4 1.4H8.2a1.4 1.4 0 0 1-1.4-1.4V5.2a1.4 1.4 0 0 1 1.4-1.4z"/><path d="M10.6 6.4h2.8"/><path d="M11.9 17.6h.2"/>`,
  // パレット（えがく・うつす）
  palette: `<path d="M12 4.2a7.8 7.8 0 0 0 0 15.6c1.1 0 1.9-.8 1.9-1.8 0-.5-.2-.9-.5-1.2-.3-.3-.5-.7-.5-1.2 0-1 .8-1.8 1.8-1.8h1.5a3.6 3.6 0 0 0 3.6-3.6c0-3.3-3.5-6-7.8-6z"/><circle cx="8.4" cy="9.8" r=".95" fill="currentColor" stroke="none"/><circle cx="12" cy="7.9" r=".95" fill="currentColor" stroke="none"/><circle cx="15.5" cy="9.5" r=".95" fill="currentColor" stroke="none"/><circle cx="7.7" cy="13.6" r=".95" fill="currentColor" stroke="none"/>`,
  // 拡声器（つたえる・企画）
  megaphone: `<path d="M5.6 10 14.4 6.2v11.6L5.6 14z"/><path d="M8.6 15.3v4.4"/><path d="M16.6 9.4 18.9 8.1"/><path d="M17.4 12h2.4"/><path d="M16.6 14.6 18.9 15.9"/>`,
  // 吹き出し（声をかける）
  bubble: `<path d="M5.4 5.8h13.2a1.6 1.6 0 0 1 1.6 1.6v7.2a1.6 1.6 0 0 1-1.6 1.6h-6.8L7.8 19.6v-3.4H5.4a1.6 1.6 0 0 1-1.6-1.6V7.4a1.6 1.6 0 0 1 1.6-1.6z"/><path d="M9 11h.1"/><path d="M12 11h.1"/><path d="M15 11h.1"/>`,
  // 吹き出し（声をかけて＝ナビのピル）。中身は点3つ。
  // 「！」は UI では警告・エラーの合図に読まれるので使わない（愛嬌ではなく注意喚起の温度になる）。
  'bubble-call': `<path d="M5.4 5.8h13.2a1.6 1.6 0 0 1 1.6 1.6v7.2a1.6 1.6 0 0 1-1.6 1.6h-6.8L7.8 19.6v-3.4H5.4a1.6 1.6 0 0 1-1.6-1.6V7.4a1.6 1.6 0 0 1 1.6-1.6z"/><path d="M9 11h.02"/><path d="M12 11h.02"/><path d="M15 11h.02"/>`,
  // 電球（つくってるもの）
  bulb: `<path d="M12 4.4a5.4 5.4 0 0 0-3.1 9.8v1.6h6.2v-1.6a5.4 5.4 0 0 0-3.1-9.8z"/><path d="M9.8 17.6h4.4"/><path d="M10.6 19.6h2.8"/>`,
  // 封筒（メール）
  mail: `<path d="M3.8 6.4h16.4v11.2H3.8z"/><path d="M3.8 7.2L12 13l8.2-5.8"/>`,
  // ふたり（なかま・置いてけぼりにしない）
  people: `<circle cx="9.2" cy="9" r="2.8"/><path d="M4 18.8c0-2.9 2.3-4.6 5.2-4.6s5.2 1.7 5.2 4.6"/><circle cx="16.8" cy="10.2" r="2.2"/><path d="M14.8 14.6c3-.6 5.2 1.2 5.2 4.2"/>`,
  // 芽（初心者を育てる）
  sprout: `<path d="M12 19.6v-5.6"/><path d="M12 14c-3.7 0-5.6-1.7-5.6-4.8 3.7 0 5.6 1.7 5.6 4.8z"/><path d="M12 14c0-3.5 1.9-5.2 5.4-5.2 0 3.5-1.9 5.2-5.4 5.2z"/><path d="M8 19.8h8"/>`,
  // クラッカー（交流・紙吹雪）
  confetti: `<path d="M4.4 19.6l4.2-9.8 5.6 5.6-9.8 4.2z"/><path d="M16.8 5.2v2.2"/><path d="M19.6 8.2l-2 1.2"/><path d="M16 11.6l2.2.6"/><path d="M18.8 4.6l-1.4 1.6"/>`,
  // ヘッドホン（きいてみる）
  headphone: `<path d="M5.4 14.4v-2.2a6.6 6.6 0 0 1 13.2 0v2.2"/><path d="M4 15.4a1.9 1.9 0 0 1 1.9-1.9h1.2v5.6H5.9A1.9 1.9 0 0 1 4 17.2z"/><path d="M20 15.4a1.9 1.9 0 0 0-1.9-1.9h-1.2v5.6h1.2a1.9 1.9 0 0 0 1.9-1.9z"/>`,
  // 野球（球場）
  baseball: `<circle cx="12" cy="12" r="7.8"/><path d="M8.4 5.4c2.2 2.4 2.2 10.8 0 13.2"/><path d="M15.6 5.4c-2.2 2.4-2.2 10.8 0 13.2"/>`,
  // ハート（推し活）
  heart: `<path d="M12 19.4c-4.1-2.9-7.4-5.5-7.4-8.9a3.9 3.9 0 0 1 7.4-1.7 3.9 3.9 0 0 1 7.4 1.7c0 3.4-3.3 6-7.4 8.9z"/>`,
};

interface Props { name: string; size?: number; sw?: number; class?: string; }
const { name, size = 20, sw = 1.8, class: cls = '' } = Astro.props;
const body = ICONS[name];
if (!body) throw new Error(`Icon.astro: 未定義のアイコン名 "${name}"`);
---
<svg
  class={`icn ${cls}`.trim()}
  width={size} height={size} viewBox="0 0 24 24"
  fill="none" stroke="currentColor" stroke-width={sw}
  stroke-linecap="round" stroke-linejoin="round"
  aria-hidden="true" focusable="false"
  set:html={body}
/>

<style>
  .icn { display: inline-block; vertical-align: -.16em; flex: 0 0 auto; }
</style>
