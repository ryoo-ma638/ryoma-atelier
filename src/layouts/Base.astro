---
import { ClientRouter } from 'astro:transitions';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/fonts-main.css';

interface Props { title?: string; description?: string; }
const {
  title = '稜馬のポートフォリオ｜大崎稜馬',
  description = 'つくる人で、バンテリンドームのビール売り子。大崎稜馬（愛知工業大学）のポートフォリオ。CG・画像処理・Web・ゲームを、これだと思ったら最後までつくります。',
} = Astro.props;
const site = Astro.site ?? new URL('https://ryoma-atelier.vercel.app');
const ogImage = new URL('/og.png?v=1', site).href;
const canonical = new URL(Astro.url.pathname, site).href;
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <!-- OGP / Twitter -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="稜馬のアトリエ" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="稜馬のアトリエ — つくって、手渡す。" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <!-- Webフォントは自前配信（src/styles/fonts-main.css）。Google Fonts への通信は無し。 -->
  <ClientRouter />
</head>
<body>
  <a class="skip" href="#main">本文へスキップ</a>
  <slot />
  <script>
    import '../scripts/motion.js';
  </script>
  <style is:global>
    .skip { position: absolute; left: -999px; top: 0; z-index: 200; background: var(--ink); color: var(--paper); padding: .6rem 1rem; border-radius: 0 0 var(--r-sm) 0; }
    .skip:focus { left: 0; }
  </style>
</body>
</html>
